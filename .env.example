# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Supabase Postgres) ---
# Supabase dashboard -> Project Settings -> Database -> Connection string -> "URI"
# Use the pooled "Transaction" connection string (port 6543, host
# aws-0-<region>.pooler.supabase.com, user postgres.<project-ref>) by default -
# Supabase's direct host (db.<ref>.supabase.co, port 5432) resolves to an
# IPv6 address, and most hosting platforms (Render included - confirmed by a
# real ENETUNREACH in production) have no outbound IPv6 route to it. The
# pooler host is IPv4 and works everywhere. Only use the direct connection if
# your host explicitly supports outbound IPv6 and you've verified it.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
# Supabase requires TLS. Keep this true unless connecting to a local Postgres without SSL.
DATABASE_SSL=true

# --- Session ---
SESSION_SECRET=change_this_to_a_long_random_string

# --- App ---
PORT=3000
APP_BASE_URL=http://localhost:3000
# State code of the business's own GST registration (used for the IGST vs CGST/SGST rule).
BUSINESS_GST_STATE_CODE=32

# --- Email (used for password-reset links) ---
# Any SMTP provider works (Gmail app password, SendGrid, Mailtrap, Supabase's own SMTP, etc).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Invoice App <no-reply@example.com>"
