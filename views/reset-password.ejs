<!DOCTYPE html>
<html lang="en">
<head>
  <title>Set New Password - Invoice App</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-card">
      <h1>Set a new password</h1>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
        <div class="auth-links"><a href="/forgot-password">Request a new link</a></div>
      <% } else { %>
        <form method="POST" action="/reset-password">
          <input type="hidden" name="token" value="<%= token %>">
          <div class="field">
            <label>New Password</label>
            <input type="password" name="password" required>
          </div>
          <div class="field">
            <label>Confirm Password</label>
            <input type="password" name="confirmPassword" required>
          </div>
          <div class="field-hint" style="margin-bottom:16px;">
            5–6 characters, with at least one uppercase letter, one lowercase letter, one number, and one special character.
          </div>
          <button type="submit" class="btn btn-block">Reset Password</button>
        </form>
      <% } %>
    </div>
  </div>
</body>
</html>
