<!DOCTYPE html>
<html lang="en">
<head>
  <title>Dashboard - Invoice App</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'dashboard' }) %>
    <div class="main">
      <div class="page-header">
        <h1>Dashboard</h1>
        <a href="/report" class="btn btn-secondary">REPORT</a>
      </div>

      <div class="cards">
        <div class="card">
          <div class="label">Total Invoices</div>
          <div class="value"><%= totalInvoices %></div>
        </div>
      </div>

      <h3>Recent Invoices</h3>
      <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Invoice #</th>
            <th>Date</th>
            <th>Billed To</th>
            <th>Total</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (recentInvoices.length === 0) { %>
            <tr><td colspan="6" style="text-align:center;color:#6b7280;">No invoices yet. Use "Create Invoice" in the sidebar to add one.</td></tr>
          <% } %>
          <% recentInvoices.forEach(function(inv) { %>
            <tr>
              <td><%= inv.invoice_number %></td>
              <td><%= new Date(inv.invoice_date).toLocaleDateString('en-IN') %></td>
              <td><%= inv.billed_to_name %></td>
              <td>₹<%= Number(inv.total_amount).toFixed(2) %></td>
              <td>
                <span class="status-badge <%= inv.status === 'CANCELLED' ? 'status-cancelled' : 'status-active' %>">
                  <%= inv.status %>
                </span>
              </td>
              <td><a href="/invoices/<%= inv.id %>">View</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    </div>
  </div>
</body>
</html>
