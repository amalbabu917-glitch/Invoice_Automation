<!DOCTYPE html>
<html lang="en">
<head>
  <title>Reset Your Password - Invoice App</title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-card">
      <h1>Reset Your Password</h1>
      <p class="subtitle">Enter the email on your account and we'll send you a reset link.</p>

      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

      <% if (!message) { %>
      <form method="POST" action="/forgot-password">
        <div class="field">
          <label>Email</label>
          <input type="email" name="email" required>
        </div>
        <button type="submit" class="btn btn-block">Send Reset Link</button>
      </form>
      <% } %>

      <div class="auth-links"><a href="/login">Back to sign in</a></div>
    </div>
  </div>
</body>
</html>
